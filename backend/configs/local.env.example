# Local development placeholders only.
# Do not use these values in production.

POSTGRES_DB=mcp_secret_manager
POSTGRES_USER=mcp_secret_manager
POSTGRES_PASSWORD=mcp_secret_manager_dev_password
POSTGRES_PORT=5432

MCP_SECRET_MANAGER_ENVIRONMENT=local
MCP_SECRET_MANAGER_SERVICE_NAME=mcp-secret-manager
MCP_SECRET_MANAGER_LOG_LEVEL=INFO
MCP_SECRET_MANAGER_OTEL_TRACES_ENABLED=false
MCP_SECRET_MANAGER_OTEL_EXPORTER_OTLP_ENDPOINT=
MCP_SECRET_MANAGER_DATABASE_URL=postgresql+asyncpg://mcp_secret_manager:mcp_secret_manager_dev_password@127.0.0.1:5432/mcp_secret_manager
MCP_SECRET_MANAGER_REST_HOST=127.0.0.1
MCP_SECRET_MANAGER_REST_PORT=8000
MCP_SECRET_MANAGER_OPENAPI_ENABLED=true
MCP_SECRET_MANAGER_SECURITY_HEADERS_ENABLED=true
MCP_SECRET_MANAGER_RATE_LIMIT_ENABLED=true
MCP_SECRET_MANAGER_RATE_LIMIT_REQUESTS=120
MCP_SECRET_MANAGER_RATE_LIMIT_WINDOW_SECONDS=60
MCP_SECRET_MANAGER_RATE_LIMIT_EXEMPT_PATHS=/v1/health,/v1/metrics
MCP_SECRET_MANAGER_RATE_LIMIT_MAX_CLIENTS=10000
MCP_SECRET_MANAGER_AUDIT_RETENTION_DAYS=365

# Local development placeholder only. Generate a real 32-byte base64 key per deployment.
MCP_SECRET_MANAGER_MASTER_KEY_BASE64=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
MCP_SECRET_MANAGER_MASTER_KEY_VERSION=1
